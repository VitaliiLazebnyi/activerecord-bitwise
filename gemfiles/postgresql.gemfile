# The suite against a PostgreSQL server (CI: BUNDLE_GEMFILE=gemfiles/postgresql.gemfile and DATABASE_URL).
source 'https://rubygems.org'

# The gem with its runtime and development dependencies.
gemspec path: '..'

# The PostgreSQL adapter.
gem 'pg', '~> 1.7'
